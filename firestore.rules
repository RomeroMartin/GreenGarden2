rules_version = '2';

// Green Garden — bolsa de trabajo.
// Se pegan en: Consola de Firebase → Firestore Database → Reglas → Publicar.
//
// Modelo de acceso:
//   · Público (sin login)  → solo puede CREAR una postulación válida. No puede leer, listar, editar ni borrar nada.
//   · Staff (con login)    → lee todas las postulaciones, cambia el estado y agrega notas.
//   · Admin                → además puede borrar postulaciones y notas.
//
// "Staff" = usuario cuyo mail tiene un documento en la colección `staff` (el ID del documento es el mail en minúsculas):
//   staff/<mail>  →  { rol: "admin" | "encargado", sector: "cocina" | "panaderia" | "barra" | "salon" | "playroom", nombre: "..." }
// El primer admin se crea a mano desde la consola; después, los admin crean y quitan usuarios desde el panel.

service cloud.firestore {
  match /databases/{database}/documents {

    function mail() { return request.auth.token.email.lower(); }
    function esStaff() {
      return request.auth != null && request.auth.token.email != null
        && exists(/databases/$(database)/documents/staff/$(mail()));
    }
    function esAdmin() {
      return esStaff()
        && get(/databases/$(database)/documents/staff/$(mail())).data.rol == 'admin';
    }

    // ── Staff: cada usuario lee su propio documento (para saber su sector); el admin gestiona a todos.
    match /staff/{email} {

      function sectorValido(s) { return s in ['', 'cocina', 'panaderia', 'barra', 'salon', 'playroom']; }

      function staffNuevoValido(d) {
        return d.keys().hasOnly(['rol', 'sector', 'nombre', 'creadoPor', 'creadoEn'])
          && d.keys().hasAll(['rol', 'sector', 'nombre', 'creadoPor', 'creadoEn'])
          && d.rol in ['admin', 'encargado']
          && d.sector is string && sectorValido(d.sector)
          && (d.rol == 'admin' || d.sector != '')
          && d.nombre is string && d.nombre.size() >= 2 && d.nombre.size() <= 80
          && d.creadoPor == mail()
          && d.creadoEn == request.time;
      }

      function staffEdicionValida(d) {
        return d.diff(resource.data).affectedKeys().hasOnly(['rol', 'sector', 'nombre'])
          && d.rol in ['admin', 'encargado']
          && d.sector is string && sectorValido(d.sector)
          && (d.rol == 'admin' || d.sector != '')
          && d.nombre is string && d.nombre.size() >= 2 && d.nombre.size() <= 80
          && (email != mail() || d.rol == 'admin');
      }

      allow get: if request.auth != null && request.auth.token.email != null && (email == mail() || esAdmin());
      allow list: if esAdmin();
      allow create: if esAdmin() && email == email.lower() && staffNuevoValido(request.resource.data);
      allow update: if esAdmin() && staffEdicionValida(request.resource.data);
      allow delete: if esAdmin() && email != mail();
    }

    // ── Postulaciones
    match /postulaciones/{id} {

      function postulacionValida(d) {
        return d.keys().hasOnly([
            'nombre', 'telefono', 'email', 'zona', 'puestos', 'extras', 'disponibilidad',
            'experienciaAnios', 'trabajos', 'resumen', 'referencias', 'consentimiento', 'foto', 'estado', 'creadoEn'
          ])
          && d.keys().hasAll([
            'nombre', 'telefono', 'email', 'zona', 'puestos', 'extras', 'disponibilidad',
            'experienciaAnios', 'trabajos', 'resumen', 'referencias', 'consentimiento', 'foto', 'estado', 'creadoEn'
          ])
          && d.nombre is string && d.nombre.size() >= 2 && d.nombre.size() <= 80
          && d.telefono is string && d.telefono.matches('^[0-9]{10}$')
          && d.email is string && d.email.size() <= 120 && d.email.matches('^[^@ ]+@[^@ ]+\\.[^@ ]+$')
          && d.zona is string && d.zona.size() >= 2 && d.zona.size() <= 80
          && d.puestos is list && d.puestos.size() >= 1 && d.puestos.size() <= 4
          && d.puestos.hasOnly([
            'cocinero', 'bachero', 'parrillero', 'pizzero', 'jefe-cocina', 'pastelero', 'panadero',
            'bartender', 'barista', 'camarero', 'recepcionista', 'mostrador', 'cajero', 'jefe-sala', 'playroom'
          ])
          && d.extras is map && d.extras.size() <= 20
          && d.disponibilidad is map
          && d.disponibilidad.keys().hasOnly(['grilla', 'empieza', 'jornada', 'feriados'])
          && d.disponibilidad.grilla is list && d.disponibilidad.grilla.size() >= 1 && d.disponibilidad.grilla.size() <= 21
          && d.disponibilidad.empieza is string && d.disponibilidad.empieza.size() <= 40
          && d.disponibilidad.jornada is string && d.disponibilidad.jornada.size() <= 40
          && d.disponibilidad.feriados is bool
          && d.experienciaAnios is string && d.experienciaAnios.size() <= 40
          && d.trabajos is list && d.trabajos.size() <= 3
          && d.resumen is string && d.resumen.size() <= 800
          && d.referencias is string && d.referencias.size() <= 400
          && d.foto is string && d.foto.size() <= 90000
          && (d.foto == '' || d.foto.matches('^data:image/jpeg;base64,.*$'))
          && d.consentimiento == true
          && d.estado == 'nuevo'
          && d.creadoEn == request.time;
      }

      // Solo se puede tocar el estado, y queda registrado quién y cuándo.
      function cambioDeEstadoValido() {
        let d = request.resource.data;
        return d.diff(resource.data).affectedKeys().hasOnly(['estado', 'estadoPor', 'estadoEn'])
          && d.estado in ['nuevo', 'contactado', 'entrevista', 'contratado', 'descartado']
          && d.estadoPor == mail()
          && d.estadoEn == request.time;
      }

      // Resumen de la última nota (para mostrarla en el listado sin abrir la postulación).
      function resumenDeNotaValido() {
        let d = request.resource.data;
        return d.diff(resource.data).affectedKeys().hasOnly(['ultimaNota', 'ultimaNotaPor', 'ultimaNotaEn', 'cantNotas'])
          && d.ultimaNota is string && d.ultimaNota.size() >= 1 && d.ultimaNota.size() <= 200
          && d.ultimaNotaPor == mail()
          && d.ultimaNotaEn == request.time
          && d.cantNotas is int && d.cantNotas >= 1 && d.cantNotas <= 500;
      }

      allow create: if postulacionValida(request.resource.data);
      allow read: if esStaff();
      allow update: if esStaff() && (cambioDeEstadoValido() || resumenDeNotaValido());
      allow delete: if esAdmin();

      // Notas internas: se agregan, no se editan. Cada una queda firmada por quien la escribió.
      match /notas/{notaId} {
        allow read: if esStaff();
        allow create: if esStaff()
          && request.resource.data.keys().hasOnly(['texto', 'por', 'en'])
          && request.resource.data.texto is string
          && request.resource.data.texto.size() >= 1 && request.resource.data.texto.size() <= 1000
          && request.resource.data.por == mail()
          && request.resource.data.en == request.time;
        allow update: if false;
        allow delete: if esAdmin();
      }
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
